generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

// ═══════════════════════════════════════════════
// USER MODEL
// ═══════════════════════════════════════════════

model User {
  id        String  @id @default(auto()) @map("_id") @db.ObjectId
  firstName String
  lastName  String
  fullName  String?
  email     String  
  phone     String @unique
  photo     String?
  bio       String?
  fcmToken  String?

  role   UserRole   @default(USER)
  status UserStatus @default(ACTIVE)

  isEmailVerified Boolean @default(false)
  isPhoneVerified Boolean @default(false)
  isDeleted       Boolean @default(false)

  // ── Stripe Integration ─────────────────────────
  stripeCustomerId      String? // Used for charging the user (sender)
  stripeAccountId       String? // Stripe Connect account (receiver)
  stripeAccountVerified Boolean @default(false) // Indicates if Connect account is fully verified

  // ── Relations ─────────────────────────────────
  auth             UserAuth?
  paymentMethods   PaymentMethod[]
  sentTips         Tip[]             @relation("SentTips")
  receivedTips     Tip[]             @relation("ReceivedTips")
  notifications    Notification[]
  wallet           Wallet?
  withdrawRequests WithdrawRequest[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("users")
}

// ═══════════════════════════════════════════════
// USER AUTH
// ═══════════════════════════════════════════════

model UserAuth {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  password          String
  passwordChangedAt DateTime?
  lastLoginAt       DateTime?

  // ── Relation ──────────────────────────────────
  userId String @unique @db.ObjectId
  user   User   @relation(fields: [userId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("user_auths")
}

// ═══════════════════════════════════════════════
// PAYMENT METHOD
// Stores saved Stripe cards and digital wallets
// ═══════════════════════════════════════════════

model PaymentMethod {
  id     String @id @default(auto()) @map("_id") @db.ObjectId
  userId String @db.ObjectId
  user   User   @relation(fields: [userId], references: [id])

  type PaymentType // CARD | APPLE_PAY | GOOGLE_PAY

  // ── Stripe Reference ──────────────────────────
  stripePaymentMethodId String? // Stripe's payment method ID (source of truth)

  // ── Card Metadata (safe to store for UI) ──────
  brand    String? // visa, mastercard, amex
  last4    String? // Last 4 digits of the card
  expMonth Int?    // Card expiry month
  expYear  Int?    // Card expiry year

  // ── Digital Wallet Info ───────────────────────
  walletType  String? // apple_pay | google_pay
  displayName String? // e.g. "Visa •••• 4242"

  // ── Status ────────────────────────────────────
  isDefault Boolean @default(false) // Whether this is the user's default payment method
  isActive  Boolean @default(true)  // Soft delete flag

  transactions Transaction[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([stripePaymentMethodId])
  @@map("payment_methods")
}

// ═══════════════════════════════════════════════
// TIP MODEL
// ═══════════════════════════════════════════════

model Tip {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  // ── Sender & Receiver ─────────────────────────
  senderId   String @db.ObjectId
  sender     User   @relation("SentTips", fields: [senderId], references: [id])
  receiverId String @db.ObjectId
  receiver   User   @relation("ReceivedTips", fields: [receiverId], references: [id])

  // ── Amount Details ────────────────────────────
  amount   Float
  currency String @default("usd")

  // ── Optional Message ──────────────────────────
  message String?

  // ── Status & Payment Reference ────────────────
  status      TipStatus    @default(PENDING)
  transaction Transaction?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("tips")
}

// ═══════════════════════════════════════════════
// TRANSACTION MODEL
// Payment record for each tip.
// Money is held in the platform Stripe account.
// Receiver's wallet balance is updated on success.
// ═══════════════════════════════════════════════

model Transaction {
  id    String @id @default(auto()) @map("_id") @db.ObjectId
  tipId String @unique @db.ObjectId
  tip   Tip    @relation(fields: [tipId], references: [id])

  paymentMethodId String?        @db.ObjectId
  paymentMethod   PaymentMethod? @relation(fields: [paymentMethodId], references: [id])

  // ── Stripe References ─────────────────────────
  stripePaymentIntentId String? // PaymentIntent ID from Stripe
  stripeChargeId        String? // Charge ID after payment is captured
  applicationFeeAmount  Float?  // Platform fee collected via Stripe

  // ── Apple Pay Reference ───────────────────────
  applePayTransactionId String?

  // ── Financial Breakdown ───────────────────────
  amount      Float              // Total amount charged to the sender
  platformFee Float  @default(0) // Fee retained by the platform
  netAmount   Float              // Amount credited to the receiver's wallet after fee
  currency    String @default("usd")

  // ── Status Tracking ───────────────────────────
  status        TransactionStatus @default(PENDING)
  failureReason String?           // Populated if the transaction fails
  refundedAt    DateTime?         // Timestamp if the transaction was refunded

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("transactions")
}

// ═══════════════════════════════════════════════
// WALLET MODEL
// Tracks each receiver's platform balance.
// Funds are held in the platform Stripe account
// until the user initiates a withdrawal.
// ═══════════════════════════════════════════════

model Wallet {
  id     String @id @default(auto()) @map("_id") @db.ObjectId
  userId String @unique @db.ObjectId
  user   User   @relation(fields: [userId], references: [id])

  totalEarned      Float @default(0) // Lifetime total received from tips (never decreases)
  totalWithdrawn   Float @default(0) // Lifetime total successfully withdrawn
  availableBalance Float @default(0) // Amount the user can currently withdraw
  pendingBalance   Float @default(0) // Amount locked in an in-progress withdrawal

  currency String @default("usd")

  withdrawRequests WithdrawRequest[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("wallets")
}

// ═══════════════════════════════════════════════
// WITHDRAW REQUEST MODEL
// Created when a user requests a withdrawal.
// Automatically triggers a Stripe Transfer to the
// user's connected account — no admin approval needed.
// ═══════════════════════════════════════════════

model WithdrawRequest {
  id     String @id @default(auto()) @map("_id") @db.ObjectId
  userId String @db.ObjectId
  user   User   @relation(fields: [userId], references: [id])

  walletId String @db.ObjectId
  wallet   Wallet @relation(fields: [walletId], references: [id])

  amount   Float
  currency String @default("usd")

  // ── Stripe References ─────────────────────────
  stripeTransferId String? // Transfer ID from platform account to receiver's Connect account
  stripePayoutId   String? // Payout ID from Connect account to the user's bank (managed by Stripe)

  // ── Status ────────────────────────────────────
  status        WithdrawStatus @default(PENDING)
  failureReason String?        // Populated if the Stripe transfer fails

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([status])
  @@map("withdraw_requests")
}

// ═══════════════════════════════════════════════
// NOTIFICATION MODEL
// ═══════════════════════════════════════════════

model Notification {
  id     String @id @default(auto()) @map("_id") @db.ObjectId
  userId String @db.ObjectId
  user   User   @relation(fields: [userId], references: [id])

  title String
  body  String
  type  NotificationType
  data  Json?

  isRead Boolean   @default(false)
  readAt DateTime?

  createdAt DateTime @default(now())

  @@map("notifications")
}

// ═══════════════════════════════════════════════
// ENUMS
// ═══════════════════════════════════════════════

enum UserRole {
  USER
  ADMIN
}

enum UserStatus {
  ACTIVE
  BLOCKED
}

enum PaymentType {
  CARD
  APPLE_PAY
  GOOGLE_PAY
}

enum TipStatus {
  PENDING   // Tip created, payment not yet processed
  COMPLETED // Payment successful, receiver's wallet credited
  FAILED    // Payment failed
  REFUNDED  // Payment was refunded to the sender
}

enum TransactionStatus {
  PENDING    // Transaction created, awaiting processing
  PROCESSING // Stripe is processing the payment
  COMPLETED  // Payment captured successfully
  FAILED     // Payment failed
  REFUNDED   // Payment refunded
}

enum WithdrawStatus {
  PENDING    // Request created, Stripe transfer not yet initiated
  PROCESSING // Stripe Transfer.create() has been called
  COMPLETED  // Transfer successful, funds sent to Connect account
  FAILED     // Stripe transfer failed, balance returned to availableBalance
}

enum NotificationType {
  TIP_RECEIVED
  TIP_SENT
  TIP_FAILED
  PAYMENT_METHOD_ADDED
  ACCOUNT_VERIFIED
  WITHDRAW_REQUESTED
  WITHDRAW_COMPLETED
  WITHDRAW_FAILED
  GENERAL
}
