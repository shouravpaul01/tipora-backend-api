generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

//  USER

model User {
  id        String  @id @default(auto()) @map("_id") @db.ObjectId
  firstName String
  lastName  String
  fullName  String?
  email     String  @unique
  phone     String?
  photo     String?
  bio       String?
  fcmToken  String?

  role   UserRole   @default(USER)
  status UserStatus @default(ACTIVE)

  isEmailVerified Boolean @default(false)
  isPhoneVerified Boolean @default(false)
  isDeleted       Boolean @default(false)

  // ── Stripe ────────────────────────────────────
  stripeCustomerId      String? // sender এর জন্য — card charge করতে
  stripeAccountId       String? // receiver এর জন্য — Connect account
  stripeAccountVerified Boolean @default(false)

  // ── Relations ─────────────────────────────────
  auth           UserAuth?
  paymentMethods PaymentMethod[]
  sentTips       Tip[]           @relation("SentTips")
  receivedTips   Tip[]           @relation("ReceivedTips")
  notifications  Notification[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("users")
}

model UserAuth {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  password          String
  passwordChangedAt DateTime?
  lastLoginAt       DateTime?

  // ── Relation ──────────────────────────────────
  userId String @unique @db.ObjectId
  user   User   @relation(fields: [userId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("user_auths")
}

//  PAYMENT METHOD  (Stripe card + Apple Pay)

model PaymentMethod {
  id     String @id @default(auto()) @map("_id") @db.ObjectId
  userId String @db.ObjectId
  user   User   @relation(fields: [userId], references: [id])

  type                  PaymentType
  stripePaymentMethodId String? // reference only
  isDefault             Boolean     @default(false)
  isActive              Boolean     @default(true)

  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  transactions Transaction[]

  @@map("payment_methods")
}

//  TIP

model Tip {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  // ── Parties ───────────────────────────────────
  senderId   String @db.ObjectId
  sender     User   @relation("SentTips", fields: [senderId], references: [id])
  receiverId String @db.ObjectId
  receiver   User   @relation("ReceivedTips", fields: [receiverId], references: [id])

  // ── Amount ────────────────────────────────────
  amount   Float
  currency String @default("usd")

  // ── Content ───────────────────────────────────
  message String?

  // ── Status & Payment ──────────────────────────
  status      TipStatus    @default(PENDING)
  transaction Transaction?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("tips")
}

//  TRANSACTION  (payment record)

model Transaction {
  id    String @id @default(auto()) @map("_id") @db.ObjectId
  tipId String @unique @db.ObjectId
  tip   Tip    @relation(fields: [tipId], references: [id])

  paymentMethodId String?        @db.ObjectId
  paymentMethod   PaymentMethod? @relation(fields: [paymentMethodId], references: [id])

  // ── Stripe ────────────────────────────────────
  stripePaymentIntentId String?
  stripeChargeId        String?
  stripeTransferId      String?  // platform → receiver Connect account
  applicationFeeAmount  Float?   // actual fee Stripe collected (cents থেকে convert)

  // ── Apple Pay ─────────────────────────────────
  applePayTransactionId String?

  // ── Amounts ───────────────────────────────────
  amount      Float
  platformFee Float  @default(0)
  netAmount   Float
  currency    String @default("usd")

  // ── Status ────────────────────────────────────
  status        TransactionStatus @default(PENDING)
  failureReason String?
  refundedAt    DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("transactions")
}

model Notification {
  id     String @id @default(auto()) @map("_id") @db.ObjectId
  userId String @db.ObjectId
  user   User   @relation(fields: [userId], references: [id])

  title String
  body  String
  type  NotificationType
  data  Json?

  isRead Boolean   @default(false)
  readAt DateTime?

  createdAt DateTime @default(now())

  @@map("notifications")
}

//  ENUMS

enum UserRole {
  USER
  ADMIN
}

enum UserStatus {
  ACTIVE
  BLOCKED
}

enum PaymentType {
  CARD
  APPLE_PAY
  GOOGLE_PAY
}

enum TipStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
}

enum TransactionStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  REFUNDED
}


enum NotificationType {
  TIP_RECEIVED
  TIP_SENT
  TIP_FAILED
  PAYMENT_METHOD_ADDED
  ACCOUNT_VERIFIED
  GENERAL
}
