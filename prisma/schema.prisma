generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

// USER MODEL

model User {
  id        String  @id @default(auto()) @map("_id") @db.ObjectId
  firstName String
  lastName  String
  fullName  String?
  email     String  @unique
  phone     String?
  photo     String?
  bio       String?
  fcmToken  String?

  role   UserRole   @default(USER)
  status UserStatus @default(ACTIVE)

  isEmailVerified Boolean @default(false)
  isPhoneVerified Boolean @default(false)
  isDeleted       Boolean @default(false)

  // ── Stripe Integration ─────────────────────────
  stripeCustomerId      String? // Used for charging the user (sender)
  stripeAccountId       String? // Stripe Connect account (receiver)
  stripeAccountVerified Boolean @default(false) // Indicates if account is fully verified

  // ── Relations ─────────────────────────────────
  auth           UserAuth?
  paymentMethods PaymentMethod[]
  sentTips       Tip[]           @relation("SentTips")
  receivedTips   Tip[]           @relation("ReceivedTips")
  notifications  Notification[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("users")
}

model UserAuth {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  password          String
  passwordChangedAt DateTime?
  lastLoginAt       DateTime?

  // ── Relation ──────────────────────────────────
  userId String @unique @db.ObjectId
  user   User   @relation(fields: [userId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("user_auths")
}

// PAYMENT METHOD (Stored Stripe cards / wallets)

model PaymentMethod {
  id     String @id @default(auto()) @map("_id") @db.ObjectId
  userId String @db.ObjectId
  user   User   @relation(fields: [userId], references: [id])

  // ── Type ──────────────────────────────────────
  type PaymentType // CARD | APPLE_PAY | GOOGLE_PAY

  // ── Stripe Reference (Source of truth) ────────
  stripePaymentMethodId String? 

  // ── Card Metadata (Safe, for UI optimization) ─
  brand    String? // visa, mastercard, amex
  last4    String? // last 4 digits
  expMonth Int?
  expYear  Int?

  // ── Wallet Info ──────────────────────────────
  walletType String? // apple_pay | google_pay

  displayName String? // e.g. "Visa •••• 4242"


  // ── Status ───────────────────────────────────
  isDefault Boolean @default(false)
  isActive  Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  transactions Transaction[]

  @@index([userId])
  @@index([stripePaymentMethodId])
  @@map("payment_methods")
}
// TIP MODEL

model Tip {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  // ── Sender & Receiver ─────────────────────────
  senderId   String @db.ObjectId
  sender     User   @relation("SentTips", fields: [senderId], references: [id])
  receiverId String @db.ObjectId
  receiver   User   @relation("ReceivedTips", fields: [receiverId], references: [id])

  // ── Amount Details ────────────────────────────
  amount   Float
  currency String @default("usd")

  // ── Optional Message ──────────────────────────
  message String?

  // ── Status & Payment Reference ────────────────
  status      TipStatus    @default(PENDING)
  transaction Transaction?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("tips")
}

// TRANSACTION MODEL (Payment record)

model Transaction {
  id    String @id @default(auto()) @map("_id") @db.ObjectId
  tipId String @unique @db.ObjectId
  tip   Tip    @relation(fields: [tipId], references: [id])

  paymentMethodId String?        @db.ObjectId
  paymentMethod   PaymentMethod? @relation(fields: [paymentMethodId], references: [id])

  // ── Stripe References ─────────────────────────
  stripePaymentIntentId String?
  stripeChargeId        String?
  stripeTransferId      String? // Transfer to connected account
  applicationFeeAmount  Float?  // Platform fee collected by Stripe

  // ── Apple Pay Reference ───────────────────────
  applePayTransactionId String?

  // ── Financial Breakdown ───────────────────────
  amount      Float
  platformFee Float  @default(0)
  netAmount   Float
  currency    String @default("usd")

  // ── Status Tracking ───────────────────────────
  status        TransactionStatus @default(PENDING)
  failureReason String?
  refundedAt    DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("transactions")
}

// NOTIFICATION MODEL

model Notification {
  id     String @id @default(auto()) @map("_id") @db.ObjectId
  userId String @db.ObjectId
  user   User   @relation(fields: [userId], references: [id])

  title String
  body  String
  type  NotificationType
  data  Json?

  isRead Boolean   @default(false)
  readAt DateTime?

  createdAt DateTime @default(now())

  @@map("notifications")
}

// ENUMS

enum UserRole {
  USER
  ADMIN
}

enum UserStatus {
  ACTIVE
  BLOCKED
}

enum PaymentType {
  CARD
  APPLE_PAY
  GOOGLE_PAY
}

enum TipStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
}

enum TransactionStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  REFUNDED
}

enum NotificationType {
  TIP_RECEIVED
  TIP_SENT
  TIP_FAILED
  PAYMENT_METHOD_ADDED
  ACCOUNT_VERIFIED
  GENERAL
}