                  "  const body = pm.response.json();",
                  "  if (body?.data?.id) pm.collectionVariables.set('tipId', body.data.id);",
                  "  pm.test('Tip sent', () => pm.expect([200,201]).to.include(pm.response.code));",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{accessToken}}" }] },
