{
  "info": {
    "name": "Tipora Backend API",
    "description": "Complete API collection for the Tipora backend.\n\n**Base URL:** `{{baseUrl}}`\n\n**Auth:** Cookie-based JWT. After login/register, `accessToken` and `refreshToken` are set via HTTP-only cookies automatically.\n\n**Variables:**\n- `baseUrl` → `http://localhost:5000/api/v1`\n- `accessToken` → auto-populated after login\n- `refreshToken` → auto-populated after login",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "_postman_id": "tipora-api-collection-v1"
  },
  "variable": [
    { "key": "baseUrl",       "value": "http://localhost:5000/api/v1", "type": "string" },
    { "key": "accessToken",   "value": "",  "type": "string" },
    { "key": "refreshToken",  "value": "",  "type": "string" },
    { "key": "userId",        "value": "",  "type": "string" },
    { "key": "ticketId",      "value": "",  "type": "string" },
    { "key": "tipId",         "value": "",  "type": "string" },
    { "key": "withdrawId",    "value": "",  "type": "string" },
    { "key": "paymentMethodId","value": "", "type": "string" },
    { "key": "notificationId","value": "",  "type": "string" },
    { "key": "platformRevenueId","value": "","type": "string" }
  ],
  "auth": {
    "type": "apikey",
    "apikey": [
      { "key": "key",   "value": "Authorization", "type": "string" },
      { "key": "value", "value": "Bearer {{accessToken}}", "type": "string" },
      { "key": "in",    "value": "header", "type": "string" }
    ]
  },
  "item": [

    {
      "name": "🔐 Auth",
      "description": "Registration, OTP verification, login, logout, password reset flows.",
      "item": [
        {
          "name": "Register",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201) {",
                  "  const body = pm.response.json();",
                  "  if (body?.data?.user?.id) {",
                  "    pm.collectionVariables.set('userId', body.data.user.id);",
                  "  }",
                  "  pm.test('Registration successful', () => pm.expect(pm.response.code).to.equal(201));",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"firstName\": \"John\",\n  \"lastName\": \"Doe\",\n  \"email\": \"john.doe@example.com\",\n  \"password\": \"password123\",\n  \"phone\": \"+8801700000000\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/auth/register", "host": ["{{baseUrl}}"], "path": ["auth","register"] }
          }
        },
        {
          "name": "Verify OTP (Email)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "  const body = pm.response.json();",
                  "  if (body?.data?.accessToken) pm.collectionVariables.set('accessToken', body.data.accessToken);",
                  "  if (body?.data?.refreshToken) pm.collectionVariables.set('refreshToken', body.data.refreshToken);",
                  "  if (body?.data?.user?.id) pm.collectionVariables.set('userId', body.data.user.id);",
                  "  pm.test('OTP verified & tokens received', () => pm.expect(pm.response.code).to.equal(200));",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"john.doe@example.com\",\n  \"otp\": \"123456\",\n  \"fcmToken\": \"optional-fcm-device-token\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/auth/verify-otp", "host": ["{{baseUrl}}"], "path": ["auth","verify-otp"] }
          }
        },
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "  const body = pm.response.json();",
                  "  if (body?.data?.accessToken) pm.collectionVariables.set('accessToken', body.data.accessToken);",
                  "  if (body?.data?.refreshToken) pm.collectionVariables.set('refreshToken', body.data.refreshToken);",
                  "  if (body?.data?.user?.id) pm.collectionVariables.set('userId', body.data.user.id);",
                  "  pm.test('Login successful', () => pm.expect(pm.response.code).to.equal(200));",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"phone\": \"+8801700000000\",\n  \"password\": \"password123\",\n  \"fcmToken\": \"optional-fcm-device-token\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/auth/login", "host": ["{{baseUrl}}"], "path": ["auth","login"] }
          }
        },
        {
          "name": "Refresh Token",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "  const body = pm.response.json();",
                  "  if (body?.data?.accessToken) pm.collectionVariables.set('accessToken', body.data.accessToken);",
                  "  pm.test('Token refreshed', () => pm.expect(pm.response.code).to.equal(200));",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/auth/refresh-token", "host": ["{{baseUrl}}"], "path": ["auth","refresh-token"] }
          }
        },
        {
          "name": "Forgot Password",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"john.doe@example.com\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/auth/forgot-password", "host": ["{{baseUrl}}"], "path": ["auth","forgot-password"] }
          }
        },
        {
          "name": "Verify Reset OTP",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "  const body = pm.response.json();",
                  "  if (body?.data?.resetToken) pm.collectionVariables.set('resetToken', body.data.resetToken);",
                  "  pm.test('Reset OTP verified', () => pm.expect(pm.response.code).to.equal(200));",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"john.doe@example.com\",\n  \"otp\": \"123456\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/auth/verify-reset-otp", "host": ["{{baseUrl}}"], "path": ["auth","verify-reset-otp"] }
          }
        },
        {
          "name": "Reset Password",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"resetToken\": \"{{resetToken}}\",\n  \"newPassword\": \"newStrongPassword123\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/auth/reset-password", "host": ["{{baseUrl}}"], "path": ["auth","reset-password"] }
          }
        },
        {
          "name": "Change Password  🔒",
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{accessToken}}" }] },
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"currentPassword\": \"password123\",\n  \"newPassword\": \"newStrongPassword123\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/auth/change-password", "host": ["{{baseUrl}}"], "path": ["auth","change-password"] }
          }
        },
        {
          "name": "Logout  🔒",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.collectionVariables.set('accessToken', '');",
                  "pm.collectionVariables.set('refreshToken', '');",
                  "pm.test('Logged out', () => pm.expect(pm.response.code).to.equal(200));"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{accessToken}}" }] },
            "method": "POST",
            "header": [],
            "url": { "raw": "{{baseUrl}}/auth/logout", "host": ["{{baseUrl}}"], "path": ["auth","logout"] }
          }
        }
      ]
    },

    {
      "name": "👤 Users",
