            "body": {
              "mode": "raw",
              "raw": "{\n  \"assignedToId\": \"admin-user-id\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": { "raw": "{{baseUrl}}/support/{{ticketId}}/assign", "host": ["{{baseUrl}}"], "path": ["support","{{ticketId}}","assign"] }
          }
        },
        {
          "name": "Update Ticket Status  🔒 ADMIN",
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{accessToken}}" }] },
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"IN_PROGRESS\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": { "raw": "{{baseUrl}}/support/{{ticketId}}/status", "host": ["{{baseUrl}}"], "path": ["support","{{ticketId}}","status"] }
          }
        },
        {
          "name": "Update Ticket Priority  🔒 ADMIN",
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{accessToken}}" }] },
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"priority\": \"HIGH\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": { "raw": "{{baseUrl}}/support/{{ticketId}}/priority", "host": ["{{baseUrl}}"], "path": ["support","{{ticketId}}","priority"] }
          }
        }
      ]
    },

