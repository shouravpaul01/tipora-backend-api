    {
      "name": "🎟️ Support Tickets",
      "description": "Support ticket lifecycle — creation, messaging, admin management.",
      "item": [
        {
          "name": "Create Ticket (Guest / User)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if ([200,201].includes(pm.response.code)) {",
                  "  const body = pm.response.json();",
                  "  if (body?.data?.id) pm.collectionVariables.set('ticketId', body.data.id);",
                  "  pm.test('Ticket created', () => pm.expect([200,201]).to.include(pm.response.code));",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{accessToken}}" }] },
            "method": "POST",
            "body": {
              "mode": "formdata",
              "formdata": [
                { "key": "subject",     "value": "Issue with tip payment",     "type": "text" },
                { "key": "description", "value": "My tip did not go through and the amount was deducted from my wallet.", "type": "text" },
                { "key": "category",    "value": "PAYMENT",  "type": "text", "description": "PAYMENT | ACCOUNT | TECHNICAL | GENERAL" },
                { "key": "priority",    "value": "MEDIUM",   "type": "text", "description": "LOW | MEDIUM | HIGH | URGENT" },
                { "key": "attachments", "type": "file", "src": [], "description": "Optional — image/document attachments" }
              ]
            },
            "url": { "raw": "{{baseUrl}}/support", "host": ["{{baseUrl}}"], "path": ["support"] }
          }
        },
        {
          "name": "Get My Tickets  🔒",
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{accessToken}}" }] },
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/support/my-tickets?page=1&limit=10",
              "host": ["{{baseUrl}}"], "path": ["support","my-tickets"],
              "query": [
                { "key": "page",  "value": "1" },
                { "key": "limit", "value": "10" }
              ]
            }
          }
        },
        {
          "name": "Get Ticket Details  🔒",
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{accessToken}}" }] },
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/support/{{ticketId}}", "host": ["{{baseUrl}}"], "path": ["support","{{ticketId}}"] }
          }
        },
        {
          "name": "Add Message / Reply  🔒",
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{accessToken}}" }] },
            "method": "POST",
            "body": {
              "mode": "formdata",
              "formdata": [
                { "key": "message",        "value": "This is my reply to the support ticket.",  "type": "text" },
                { "key": "isInternalNote", "value": "false", "type": "text", "description": "Admin only — true for internal notes" },
                { "key": "attachments",    "type": "file", "src": [] }
              ]
            },
            "url": { "raw": "{{baseUrl}}/support/{{ticketId}}/messages", "host": ["{{baseUrl}}"], "path": ["support","{{ticketId}}","messages"] }
          }
        },
        {
          "name": "Reopen Ticket  🔒 USER",
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{accessToken}}" }] },
            "method": "PATCH",
            "url": { "raw": "{{baseUrl}}/support/{{ticketId}}/reopen", "host": ["{{baseUrl}}"], "path": ["support","{{ticketId}}","reopen"] }
          }
        },
        {
          "name": "Rate Ticket  🔒 USER",
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{accessToken}}" }] },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"rating\": 5,\n  \"ratingComment\": \"Very helpful and fast response!\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": { "raw": "{{baseUrl}}/support/{{ticketId}}/rate", "host": ["{{baseUrl}}"], "path": ["support","{{ticketId}}","rate"] }
          }
        },
        {
          "name": "Get All Tickets  🔒 ADMIN",
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{accessToken}}" }] },
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/support?page=1&limit=10&status=OPEN",
              "host": ["{{baseUrl}}"], "path": ["support"],
              "query": [
                { "key": "page",   "value": "1" },
                { "key": "limit",  "value": "10" },
                { "key": "status", "value": "OPEN", "description": "OPEN | IN_PROGRESS | RESOLVED | CLOSED" }
              ]
            }
          }
        },
        {
          "name": "Assign Ticket  🔒 ADMIN",
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{accessToken}}" }] },
            "method": "PATCH",
